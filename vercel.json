{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api|assets).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "memory": 1024,
            "includeFiles": "pairs.json"
        }
    }
}
